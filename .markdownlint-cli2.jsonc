{
  "config": {
    "MD013": {
      "line_length": 80,
      "code_block_line_length": 120,
      "tables": false,
      "headings": false
    },
    "MD029": { "style": "ordered" },
    "MD036": false,
    "MD004": { "style": "dash" },
    "MD010": { "code_blocks": false }
  },
  "ignores": [
    "**/.venv/**",
    "**/node_modules/**",
    "**/.terraform/**",
    "**/.terraform.lock.hcl",
    "./target/**",
    ".bun_tmp/**",
    ".uv-cache/**",
    "config/shared/**",
    ".vtcode/**",
    "**/target/**",
    ".terraform/**",
    "memories/**",
    "CRUSH.md"
  ]
}
